#!/usr/bin/env bash
#
# Build the portable Linux bundle + AppImage for Bufflehead.
#
# This is the whole "Build Linux" CI job as a script, so it can be run locally
# on a Linux box instead of only through GitHub Actions. It MUST run on Linux:
# the glibc build and the AppImage tooling are Linux-only. Build on an OLD-enough
# distro (CI uses ubuntu-22.04 / ubuntu-22.04-arm) so the glibc floor stays low
# and the AppImage runs on newer distros too.
#
# Architecture: defaults to the host's arch (`go env GOARCH`), so it builds
# NATIVELY on an amd64 or arm64 machine/runner — no cross-compilation. Override
# by exporting GOARCH=amd64|arm64. gd reads GOARCH to pick the matching export
# preset ("Linux x86_64" / "Linux arm64"); cross-arch builds would fall back to
# `zig cc`, which we avoid by giving each arch its own native runner.
#
# Unlike Windows, DuckDB needs no special toolchain here: go-duckdb ships a
# prebuilt static libduckdb.a for linux_amd64 and linux_arm64, and Linux uses
# native ELF TLS (so the gcc-14.2/emutls dance from bin/build-windows does not
# apply).
#
# Outputs (per arch):
#   releases/linux/<goarch>/            exported binary + GDExtension .so
#   releases/linux/Bufflehead-<ver>-<appimage_arch>.AppImage
#
# Prereqs the environment must provide: go >= 1.26 on PATH; a C toolchain (gcc);
# curl; file. appimagetool is downloaded on demand.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

[ "$(uname -s)" = "Linux" ] || { echo "bin/build-linux must run on Linux" >&2; exit 1; }

# --- resolve architecture ----------------------------------------------------
GOARCH="${GOARCH:-$(go env GOARCH)}"
export GOARCH
case "$GOARCH" in
  amd64) APPIMAGE_ARCH=x86_64;  TOOL_ARCH=x86_64  ;;  # AppImage/appimagetool labels
  arm64) APPIMAGE_ARCH=aarch64; TOOL_ARCH=aarch64 ;;
  *) echo "bin/build-linux: unsupported GOARCH '$GOARCH' (want amd64 or arm64)" >&2; exit 1 ;;
esac
# Guard against accidental cross-compiles: gd would silently switch to `zig cc`
# and we want native builds only (correct glibc, no zig surprises).
HOST_GOARCH="$(go env GOHOSTARCH)"
[ "$GOARCH" = "$HOST_GOARCH" ] || {
  echo "bin/build-linux: GOARCH=$GOARCH but host is $HOST_GOARCH — run on a native $GOARCH box" >&2
  exit 1
}

OUT="releases/linux/$GOARCH"
BIN="$OUT/Bufflehead"                 # export_path name in the arch's preset
SO="graphics/linux_${GOARCH}.so"      # GDExtension the binary loads from its dir
# Pin the gd CLI to the graphics.gd version in go.mod so the CLI (and the Godot
# version it targets) never floats out from under the app.
GD_VERSION="$(awk '$1=="graphics.gd"{print $2; exit}' go.mod)"

step() { printf '\n\033[1m=== %s (%s) ===\033[0m\n' "$*" "$GOARCH"; }

# --- gd CLI (pinned to go.mod) -----------------------------------------------
step "installing gd CLI $GD_VERSION"
go install "graphics.gd/cmd/gd@$GD_VERSION"
export PATH="$(go env GOPATH)/bin:$PATH"

# --- build the GDExtension .so + exported binary via gd ----------------------
# gd build -> `go build -buildmode=c-shared -o graphics/linux_<goarch>.so`, then
# Godot headless `--export-release "Linux ..."` -> releases/linux/<goarch>/Bufflehead.
#
# gd refuses to auto-download Godot when it sees GOTOOLCHAIN=local (which
# actions/setup-go pins for reproducible builds). Flip GOTOOLCHAIN to the exact
# installed version instead of "local": non-"local" re-enables gd's Godot
# download while still pinning the Go toolchain. Give gd a writable GDPATH too.
export GDPATH="${GDPATH:-$HOME/gd}"
export GOTOOLCHAIN="$(go env GOVERSION)"   # e.g. go1.26.0 (never "local")
export CGO_ENABLED=1
mkdir -p "$OUT"
step "gd build"
gd_rc=0
gd build ./cmd/viewer || gd_rc=$?
# Godot's headless export can segfault on teardown on GPU-less machines AFTER
# writing the binary. Treat the build as OK iff the expected artifacts exist and
# the .so is a real ELF shared object; otherwise fail hard.
if [ ! -f "$BIN" ] || [ ! -f "$SO" ]; then
  echo "gd build failed (exit $gd_rc): expected artifacts not produced" >&2
  exit 1
fi
file "$SO" | grep -q 'ELF 64-bit.*shared object' \
  || { echo "GDExtension .so is not a valid ELF shared object" >&2; exit 1; }
[ "$gd_rc" -eq 0 ] || echo "note: gd exited $gd_rc but artifacts are valid (Godot teardown segfault)"

# --- version: single source of truth = export_presets.cfg --------------------
V="$(grep -m1 'application/short_version' graphics/export_presets.cfg \
      | grep -oE '[0-9]+(\.[0-9]+)+')"   # e.g. 0.25.0
step "version $V"

# --- bundle GDExtension .so next to the binary -------------------------------
# The exported binary embeds the .pck (embed_pck=true); library.gdextension
# inside it points at linux_<goarch>.so, which Godot loads from the binary's own
# directory. Ship it alongside, exactly like the Windows exe+DLL bundle.
step "bundle .so next to binary"
cp -f "$SO" "$OUT/"
# Launcher for anyone running the raw bundle (not via the AppImage): same
# LD_PRELOAD workaround for the aarch64 static-TLS dlopen failure (see AppRun).
cat > "$OUT/Bufflehead.sh" <<'EOF'
#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
SO="$(ls "$HERE"/linux_*.so 2>/dev/null | head -1)"
[ -n "$SO" ] && export LD_PRELOAD="$SO${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$HERE/Bufflehead" "$@"
EOF
chmod +x "$OUT/Bufflehead.sh"

# --- assemble the AppDir -----------------------------------------------------
step "assemble AppDir"
APPDIR="releases/linux/Bufflehead-$GOARCH.AppDir"
rm -rf "$APPDIR"
mkdir -p "$APPDIR/usr/bin"
cp -f "$BIN" "$APPDIR/usr/bin/Bufflehead"
chmod +x "$APPDIR/usr/bin/Bufflehead"
cp -f "$SO" "$APPDIR/usr/bin/"        # keep the .so beside the binary
cp -f graphics/icon.png "$APPDIR/bufflehead.png"

cat > "$APPDIR/bufflehead.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Bufflehead
Comment=Native Parquet viewer
Exec=Bufflehead
Icon=bufflehead
Categories=Development;Utility;
Terminal=false
EOF

# AppRun resolves its own directory (following the AppImage mount symlink) and
# execs the real binary, so the .so beside it is found via the binary's dir.
#
# It LD_PRELOADs the GDExtension .so: it's a Go c-shared lib with initial-exec
# TLS, and Godot dlopen()s it at runtime. On aarch64 glibc the dlopen static-TLS
# surplus is too small, so the load fails with "cannot allocate memory in static
# TLS block" (and then GoMainLoop / the whole extension never registers).
# Preloading it at process startup puts its TLS in the initial static block,
# which has room. Harmless on amd64 (where the surplus already suffices).
cat > "$APPDIR/AppRun" <<'EOF'
#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
SO="$(ls "$HERE"/usr/bin/linux_*.so 2>/dev/null | head -1)"
[ -n "$SO" ] && export LD_PRELOAD="$SO${LD_PRELOAD:+:$LD_PRELOAD}"
exec "$HERE/usr/bin/Bufflehead" "$@"
EOF
chmod +x "$APPDIR/AppRun"

# --- build the AppImage ------------------------------------------------------
step "build AppImage"
TOOL="${APPIMAGETOOL:-$HOME/.cache/appimagetool-$TOOL_ARCH.AppImage}"
if [ ! -x "$TOOL" ]; then
  mkdir -p "$(dirname "$TOOL")"
  curl -fsSL -o "$TOOL" \
    "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$TOOL_ARCH.AppImage"
  chmod +x "$TOOL"
fi
OUTIMG="releases/linux/Bufflehead-$V-$APPIMAGE_ARCH.AppImage"
rm -f "$OUTIMG"
# CI runners often lack FUSE; APPIMAGE_EXTRACT_AND_RUN lets appimagetool (itself
# an AppImage) run without it. ARCH is required by appimagetool.
ARCH="$APPIMAGE_ARCH" APPIMAGE_EXTRACT_AND_RUN=1 "$TOOL" "$APPDIR" "$OUTIMG"

step "done"
echo "bundle:   $OUT/"
echo "AppImage: $OUTIMG"
