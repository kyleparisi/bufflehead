#!/bin/bash
# Build the macOS app and package it as a styled DMG (unsigned; dev/local only).
#
# Usage:
#   ./bin/release-dmg                 # universal build via `gd build`
#   ARCH=arm64  ./bin/release-dmg     # single-arch, trimmed build (bin/release-macos)
#   ARCH=x86_64 ./bin/release-dmg
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/packaging/dmg/settings.py"

cd "$ROOT"

if [ -n "${ARCH:-}" ]; then
    case "$ARCH" in
        arm64|x86_64) ;;
        *) echo "Error: ARCH must be 'arm64' or 'x86_64' (got '$ARCH')" >&2; exit 2 ;;
    esac
    APP="$ROOT/releases/darwin/$ARCH/Bufflehead.app"
    DMG="$ROOT/releases/Bufflehead-$ARCH.dmg"
    echo "Building single-arch ($ARCH) macOS app..."
    "$ROOT/bin/release-macos" "$ARCH"
else
    APP="$ROOT/releases/darwin/universal/Bufflehead.app"
    DMG="$ROOT/releases/Bufflehead.dmg"
    echo "Building universal macOS app..."
    GOOS=macos gd build ./cmd/viewer
fi

if [ ! -d "$APP" ]; then
    echo "Error: $APP not found after build" >&2
    exit 1
fi

if ! python3 -c 'import dmgbuild' >/dev/null 2>&1; then
    echo "Error: python package 'dmgbuild' is required to create the styled DMG." >&2
    echo "Install it with: python3 -m pip install --user dmgbuild" >&2
    exit 1
fi

echo "Creating styled DMG..."
rm -f "$DMG"
DMGBUILD_APP="$APP" python3 -m dmgbuild -s "$SETTINGS" "Bufflehead" "$DMG"

echo "Done: $DMG"
ls -lh "$DMG"
