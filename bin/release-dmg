#!/bin/bash
# Build a single-arch macOS app and package it as a styled per-arch DMG.
# Usage: ./bin/release-dmg <arm64|x86_64>
#   SKIP_BUILD=1   reuse the existing .app instead of rebuilding
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/packaging/dmg/settings.py"

arch="${1:-}"
case "$arch" in
    arm64|aarch64)      ARCH=arm64 ;;
    x86_64|amd64|intel) ARCH=x86_64 ;;
    "") echo "Usage: $0 <arm64|x86_64>" >&2; exit 2 ;;
    *)  echo "Error: unknown arch '$arch' (use arm64 or x86_64)" >&2; exit 2 ;;
esac

APP="$ROOT/releases/darwin/$ARCH/Bufflehead.app"
DMG="$ROOT/releases/Bufflehead-$ARCH.dmg"
: "${SKIP_BUILD:=0}"

cd "$ROOT"

if [ "$SKIP_BUILD" = "1" ]; then
    echo "Skipping build (SKIP_BUILD=1)"
else
    echo "Building $ARCH macOS app..."
    ./bin/release-macos "$ARCH"
fi

if [ ! -d "$APP" ]; then
    echo "Error: $APP not found after build" >&2
    exit 1
fi

if ! python3 -c 'import dmgbuild' >/dev/null 2>&1; then
    echo "Error: python package 'dmgbuild' is required to create the styled DMG." >&2
    echo "Install it with: python3 -m pip install --user dmgbuild" >&2
    exit 1
fi

echo "Creating styled DMG..."
rm -f "$DMG"
BUFFLEHEAD_ARCH="$ARCH" python3 -m dmgbuild -s "$SETTINGS" "Bufflehead" "$DMG"

echo "Done: $DMG"
ls -lh "$DMG"
