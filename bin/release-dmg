#!/bin/bash
# Build both single-arch macOS apps and package each as a styled per-arch DMG:
#   releases/Bufflehead-arm64.dmg
#   releases/Bufflehead-x86_64.dmg
# Usage: ./bin/release-dmg
#   SKIP_BUILD=1   reuse the existing .apps instead of rebuilding
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS="$ROOT/packaging/dmg/settings.py"
: "${SKIP_BUILD:=0}"

cd "$ROOT"

if [ "$SKIP_BUILD" = "1" ]; then
    echo "Skipping build (SKIP_BUILD=1)"
else
    ./bin/release-macos
fi

if ! python3 -c 'import dmgbuild' >/dev/null 2>&1; then
    echo "Error: python package 'dmgbuild' is required to create the styled DMG." >&2
    echo "Install it with: python3 -m pip install --user dmgbuild" >&2
    exit 1
fi

for ARCH in arm64 x86_64; do
    APP="$ROOT/releases/darwin/$ARCH/Bufflehead.app"
    DMG="$ROOT/releases/Bufflehead-$ARCH.dmg"
    [ -d "$APP" ] || { echo "Error: $APP not found" >&2; exit 1; }

    echo "Creating styled DMG for $ARCH..."
    rm -f "$DMG"
    BUFFLEHEAD_ARCH="$ARCH" python3 -m dmgbuild -s "$SETTINGS" "Bufflehead" "$DMG"
    ls -lh "$DMG"
done
