#!/bin/bash
# Build BOTH single-architecture macOS apps (arm64 + x86_64), each ~half the size
# of the universal build (~190-210M vs ~394M). Output:
#   releases/darwin/arm64/Bufflehead.app
#   releases/darwin/x86_64/Bufflehead.app
#
# How it works, per arch:
#   1. A single-arch Go/DuckDB dylib is compiled (both are built up front; the
#      x86_64 slice cross-compiles natively via Apple clang).
#   2. Godot's *universal* export template is lipo-thinned to the target arch --
#      the official template only ships godot_macos_*.universal, so a single-arch
#      export would otherwise fail looking for godot_macos_*.<arch>. No scons.
#   3. binary_format/architecture is pinned and the app exported.
#
# library.gdextension is rewritten to precise per-arch entries so the exported
# app bundles just the target-arch dylib -- while the native (arm64) Godot editor
# still loads its own-arch dylib during export (loading a foreign-arch dylib into
# the editor is SIGKILLed by the kernel as "Code Signature Invalid"). Both the
# preset and the gdextension are restored on exit, even on failure.
#
# Env overrides:
#   GODOT=/path/to/Godot   Godot 4.6 editor binary (default: ~/gd/bin/Godot.app/...)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GRAPHICS="$ROOT/graphics"
CFG="$GRAPHICS/export_presets.cfg"
GDEXT="$GRAPHICS/library.gdextension"
PRESET="macOS"
GODOT="${GODOT:-$HOME/gd/bin/Godot.app/Contents/MacOS/Godot}"

[ -x "$GODOT" ] || {
    echo "Error: Godot binary not found at $GODOT" >&2
    echo "       Run 'gd run ./cmd/viewer' once to download it, or set GODOT=..." >&2
    exit 1
}

cd "$ROOT"

# --- 1. Build both Go/DuckDB dylibs -----------------------------------------
for goarch in arm64 amd64; do
    echo "==> Building Go dylib (GOARCH=$goarch)..."
    CGO_ENABLED=1 GOARCH="$goarch" \
        go build -buildmode=c-shared \
        -o "$GRAPHICS/darwin_${goarch}.dylib" ./cmd/viewer
done

# --- 2. Locate the source export template -----------------------------------
GODOT_VERSION="$("$GODOT" --version 2>/dev/null | tr -d '\r' | head -1)"
TPL_DIR="${GODOT_VERSION%%.official*}"   # e.g. "4.6.1.stable"
SRC_TPL="$HOME/Library/Application Support/Godot/export_templates/$TPL_DIR/macos.zip"
[ -f "$SRC_TPL" ] || { echo "Error: template not found: $SRC_TPL" >&2; exit 1; }
TPL_OUT="$ROOT/releases/darwin/templates"
mkdir -p "$TPL_OUT"

# --- 3. Patch config + gdextension (restored on exit) -----------------------
BK_CFG="$(mktemp)";   cp "$CFG" "$BK_CFG"
BK_GDEXT="$(mktemp)"; cp "$GDEXT" "$BK_GDEXT"
restore() {
    [ -f "$BK_CFG" ]   && cp "$BK_CFG" "$CFG"     && rm -f "$BK_CFG"
    [ -f "$BK_GDEXT" ] && cp "$BK_GDEXT" "$GDEXT" && rm -f "$BK_GDEXT"
}
trap restore EXIT

# gdextension: precise per-arch entries. The editor (arm64) loads darwin_arm64;
# each export bundles the matching-arch dylib. Both dylibs exist (built above).
awk '
    /^macos\./ { if (!done) { print "macos.arm64    = \"darwin_arm64.dylib\"";
                              print "macos.x86_64   = \"darwin_amd64.dylib\"";
                              done = 1 } next }
    { print }
' "$BK_GDEXT" > "$GDEXT"

# The macOS preset options block is found by platform (resilient to reordering).
PRESET_IDX="$(awk '
    /^\[preset\.[0-9]+\]/ { match($0, /[0-9]+/); idx = substr($0, RSTART, RLENGTH) }
    /^platform="macOS"/   { print idx; exit }
' "$BK_CFG")"
[ -n "$PRESET_IDX" ] || { echo "Error: could not find macOS preset in $CFG" >&2; exit 1; }

# --- 4. Thin the template + export, once per arch ---------------------------
for ARCH in arm64 x86_64; do
    echo "==> Thinning export template to $ARCH..."
    THIN_TPL="$TPL_OUT/macos_$ARCH.zip"
    TWORK="$(mktemp -d)"
    (
        cd "$TWORK"
        unzip -q "$SRC_TPL"
        macos="macos_template.app/Contents/MacOS"
        for cfg in release debug; do
            lipo -thin "$ARCH" "$macos/godot_macos_${cfg}.universal" \
                -output "$macos/godot_macos_${cfg}.$ARCH"
            rm "$macos/godot_macos_${cfg}.universal"
        done
        rm -f "$THIN_TPL"
        zip -q -r -X "$THIN_TPL" macos_template.app
    )
    rm -rf "$TWORK"

    # Pin the arch + point release/debug at the thinned template (from pristine).
    awk -v arch="$ARCH" -v tzip="$THIN_TPL" -v sect="[preset.${PRESET_IDX}.options]" '
        $0 == sect { inblk = 1; print; next }
        /^\[/      { inblk = 0 }
        inblk && /^binary_format\/architecture=/ { print "binary_format/architecture=\"" arch "\""; next }
        inblk && /^custom_template\/release=/     { print "custom_template/release=\"" tzip "\""; next }
        inblk && /^custom_template\/debug=/       { print "custom_template/debug=\"" tzip "\""; next }
        { print }
    ' "$BK_CFG" > "$CFG"

    APP="$ROOT/releases/darwin/$ARCH/Bufflehead.app"
    mkdir -p "$(dirname "$APP")"
    echo "==> Exporting $ARCH app via Godot..."
    rm -rf "$APP"
    "$GODOT" --headless --path "$GRAPHICS" --export-release "$PRESET" "$APP"
    [ -d "$APP" ] || { echo "Error: $APP not produced" >&2; exit 1; }
done

restore
trap - EXIT

# --- 5. Report --------------------------------------------------------------
echo
for ARCH in arm64 x86_64; do
    APP="$ROOT/releases/darwin/$ARCH/Bufflehead.app"
    echo "Done: $APP"
    du -sh "$APP"
    lipo -info "$APP/Contents/MacOS/Bufflehead" 2>&1 | sed 's/^/  /' || true
    for d in "$APP"/Contents/Frameworks/*.dylib; do
        [ -e "$d" ] && lipo -info "$d" 2>&1 | sed 's/^/  /' || true
    done
done
