#!/bin/bash
# Run `xcrun stapler <args>`, retrying when Apple's ticket server drops the
# connection.
#
# Stapling and validating both fetch the notarization ticket from Apple's
# CloudKit endpoint (api.apple-cloudkit.com/.../com.apple.gk.ticket-delivery),
# which intermittently fails with NSURLErrorDomain -1005 "The network connection
# was lost" -> "The staple and validate action failed! Error 68." That happens
# AFTER notarytool has already returned Accepted, so failing the build there
# throws away a ~27 minute CI run over a blip. Retry those, with backoff; any
# other failure (bad signature, no ticket for this binary, ...) fails at once.
#
# Usage: bin/stapler-retry staple|validate <path>
#
# Env:
#   STAPLER_ATTEMPTS  total attempts (default 5)
#   STAPLER_BACKOFF   first delay in seconds, doubled each retry (default 10)
#   STAPLER_CMD       command to run instead of `xcrun stapler` (for testing)
set -uo pipefail

attempts="${STAPLER_ATTEMPTS:-5}"
delay="${STAPLER_BACKOFF:-10}"
# Unquoted on purpose so STAPLER_CMD can be a command plus arguments.
# shellcheck disable=SC2206
cmd=(${STAPLER_CMD:-xcrun stapler})

out="$(mktemp -t stapler-retry)"
trap 'rm -f "$out"' EXIT

for ((i = 1; ; i++)); do
    # tee keeps stapler's output streaming to the log while we keep a copy to
    # classify the failure.
    "${cmd[@]}" "$@" 2>&1 | tee "$out"
    rc=${PIPESTATUS[0]}
    [ "$rc" -eq 0 ] && exit 0

    # Error 68 is stapler's network failure; match the NSURLErrorDomain text
    # too in case a network error surfaces under a different code.
    if [ "$rc" -ne 68 ] && ! grep -q 'NSURLErrorDomain' "$out"; then
        echo "stapler-retry: 'stapler $*' failed (exit $rc), not a network error; not retrying" >&2
        exit "$rc"
    fi
    if [ "$i" -ge "$attempts" ]; then
        echo "stapler-retry: 'stapler $*' still failing (exit $rc) after $attempts attempts; giving up" >&2
        exit "$rc"
    fi
    echo "stapler-retry: 'stapler $*' hit a network error (exit $rc), attempt $i/$attempts; retrying in ${delay}s..." >&2
    sleep "$delay"
    delay=$((delay * 2))
done
