#!/bin/bash
# Build, sign and package Bufflehead for the Mac App Store, and optionally
# upload the .pkg to App Store Connect. This is the store counterpart of
# bin/sign-notarize (Developer ID); it runs locally or in CI the same way.
# The certificate walkthrough lives in docs/mac-app-store.md.
#
# Usage:
#   MAS_APP_IDENTITY="Apple Distribution: Kyle Parisi (63GMD6U4J2)" \
#   MAS_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Kyle Parisi (63GMD6U4J2)" \
#   MAS_PROFILE=~/Downloads/Bufflehead_Mac_App_Store.provisionprofile \
#   DUCKDB_AMD64=/path/to/duckdb-x86_64 DUCKDB_ARM64=/path/to/duckdb-arm64 \
#     ./bin/sign-mas
#
# Flags / env:
#   SKIP_BUILD=1      reuse releases/darwin/universal/Bufflehead.app as already
#                     exported (still re-runs the MAS engine/library preparation)
#   SKIP_PREPARE=1    the .app is already prepared by bin/prepare-mas-bundle
#   MAS_BUNDLE_ID=ID  bundle ID of the App Store Connect app record
#                     (default app.bufflehead.bufflehead)
#   BUILD_NUMBER=N    CFBundleVersion for this upload. App Store Connect rejects
#                     a build number it has already seen, so every upload needs
#                     a new one (CI uses the workflow run number). Defaults to
#                     the preset's application/version.
#   UPLOAD=1          validate + upload the .pkg to App Store Connect
#
# DUCKDB_AMD64 / DUCKDB_ARM64 are bin/build-duckdb-mas output dirs (locked,
# extension-loading-disabled engine). They are required unless SKIP_PREPARE=1.
#
# --- Credentials -------------------------------------------------------------
# Signing identities, either:
#   (a) Local — both certs in your login keychain, named by MAS_APP_IDENTITY
#       ("Apple Distribution: ..." or the older "3rd Party Mac Developer
#       Application: ...") and MAS_INSTALLER_IDENTITY ("3rd Party Mac Developer
#       Installer: ..." — Apple's portal calls it "Mac Installer Distribution").
#   (b) CI — one .p12 holding BOTH identities, imported into a throwaway
#       keychain deleted on exit. The identities are derived if unset:
#         MAS_CERT_P12_BASE64   base64 of the exported .p12
#         MAS_CERT_PASSWORD     its export password
#
# Provisioning profile (a "Mac App Store Connect" distribution profile):
#   MAS_PROFILE                 path to the .provisionprofile, or
#   MAS_PROFILE_BASE64          its base64 (CI)
#
# Upload credentials (UPLOAD=1) — the same App Store Connect API key
# bin/sign-notarize uses. It needs the App Manager (or Admin) role to upload:
#   APPLE_API_KEY_P8_BASE64, APPLE_API_KEY_ID, APPLE_API_ISSUER_ID
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="$ROOT/releases/darwin/universal/Bufflehead.app"
PKG="$ROOT/releases/Bufflehead-mas.pkg"
BASE_ENTITLEMENTS="$ROOT/packaging/macos/mas/entitlements.plist"
LIBRARY_PATH="Contents/Frameworks/darwin_universal.dylib"

: "${SKIP_BUILD:=0}"
: "${SKIP_PREPARE:=0}"
: "${UPLOAD:=0}"
# The store app record's bundle ID. It differs from the Developer ID build's
# com.kyleparisi.bufflehead (which the self-updater pins), so it's applied to
# the Info.plist here rather than in the shared Godot export preset.
: "${MAS_BUNDLE_ID:=app.bufflehead.bufflehead}"

# Same single-trap cleanup as bin/sign-notarize: transient keychain, decoded
# key material and scratch files are all torn down here, preserving $?.
CLEANUP_KEYCHAIN=""
CLEANUP_KEYCHAIN_LIST=""
CLEANUP_FILES=()
CLEANUP_DIRS=()
cleanup() {
    local rc=$?
    if [ ${#CLEANUP_FILES[@]} -gt 0 ]; then
        rm -f "${CLEANUP_FILES[@]}" || true
    fi
    if [ ${#CLEANUP_DIRS[@]} -gt 0 ]; then
        rm -rf "${CLEANUP_DIRS[@]}" || true
    fi
    if [ -n "$CLEANUP_KEYCHAIN" ]; then
        if [ -n "$CLEANUP_KEYCHAIN_LIST" ]; then
            # shellcheck disable=SC2086
            security list-keychains -d user -s $CLEANUP_KEYCHAIN_LIST 2>/dev/null || true
        fi
        security delete-keychain "$CLEANUP_KEYCHAIN" 2>/dev/null || true
    fi
    return $rc
}
trap cleanup EXIT

require() {   # require VAR_NAME "error message"
    if [ -z "${!1:-}" ]; then
        echo "Error: $2" >&2
        exit 1
    fi
}

b64decode() {   # b64decode VAR_NAME OUT_PATH
    python3 -c 'import base64, os, sys; sys.stdout.buffer.write(base64.b64decode(os.environ[sys.argv[1]]))' \
        "$1" > "$2"
}

plist_set() {   # plist_set PLIST KEY TYPE VALUE — add or replace a top-level key
    /usr/libexec/PlistBuddy -c "Delete :$2" "$1" >/dev/null 2>&1 || true
    /usr/libexec/PlistBuddy -c "Add :$2 $3 $4" "$1"
}

# --- 0a. Signing identities --------------------------------------------------
if [ -n "${MAS_CERT_P12_BASE64:-}" ]; then
    require MAS_CERT_PASSWORD "Set MAS_CERT_PASSWORD alongside MAS_CERT_P12_BASE64"
    echo "==> Importing App Store certificates into a temporary keychain..."
    KEYCHAIN="$(mktemp -d -t bufflehead-kc)/mas-signing.keychain-db"
    KEYCHAIN_PW="$(uuidgen)"
    P12="$(mktemp -t bufflehead-cert)"
    CLEANUP_FILES+=("$P12")

    b64decode MAS_CERT_P12_BASE64 "$P12"
    security create-keychain -p "$KEYCHAIN_PW" "$KEYCHAIN"
    CLEANUP_KEYCHAIN="$KEYCHAIN"
    security set-keychain-settings -lut 21600 "$KEYCHAIN"
    security unlock-keychain -p "$KEYCHAIN_PW" "$KEYCHAIN"
    security import "$P12" -k "$KEYCHAIN" -P "$MAS_CERT_PASSWORD" \
        -T /usr/bin/codesign -T /usr/bin/productbuild -T /usr/bin/security -f pkcs12
    security set-key-partition-list -S apple-tool:,apple:,codesign: \
        -s -k "$KEYCHAIN_PW" "$KEYCHAIN" >/dev/null
    CLEANUP_KEYCHAIN_LIST="$(security list-keychains -d user | tr -d '" ')"
    # shellcheck disable=SC2086
    security list-keychains -d user -s "$KEYCHAIN" $CLEANUP_KEYCHAIN_LIST

    # The installer cert is not a code-signing identity, so it only shows up
    # without -p codesigning.
    if [ -z "${MAS_APP_IDENTITY:-}" ]; then
        MAS_APP_IDENTITY="$(security find-identity -v -p codesigning "$KEYCHAIN" \
            | awk -F'"' '/Apple Distribution|3rd Party Mac Developer Application/{print $2; exit}')"
        echo "    derived MAS_APP_IDENTITY: ${MAS_APP_IDENTITY:-<none>}"
    fi
    if [ -z "${MAS_INSTALLER_IDENTITY:-}" ]; then
        MAS_INSTALLER_IDENTITY="$(security find-identity -v "$KEYCHAIN" \
            | awk -F'"' '/3rd Party Mac Developer Installer|Mac Installer Distribution/{print $2; exit}')"
        echo "    derived MAS_INSTALLER_IDENTITY: ${MAS_INSTALLER_IDENTITY:-<none>}"
    fi
fi
require MAS_APP_IDENTITY "Set MAS_APP_IDENTITY to your 'Apple Distribution: ...' identity (or MAS_CERT_P12_BASE64 to import one)"
require MAS_INSTALLER_IDENTITY "Set MAS_INSTALLER_IDENTITY to your '3rd Party Mac Developer Installer: ...' identity (it must be in MAS_CERT_P12_BASE64 too)"

# --- 0b. Provisioning profile ------------------------------------------------
if [ -n "${MAS_PROFILE_BASE64:-}" ]; then
    MAS_PROFILE="$(mktemp -t bufflehead-profile)"
    CLEANUP_FILES+=("$MAS_PROFILE")
    b64decode MAS_PROFILE_BASE64 "$MAS_PROFILE"
fi
require MAS_PROFILE "Set MAS_PROFILE (path) or MAS_PROFILE_BASE64 to a 'Mac App Store Connect' provisioning profile"
[ -f "$MAS_PROFILE" ] || { echo "Error: MAS_PROFILE not found: $MAS_PROFILE" >&2; exit 1; }

WORK="$(mktemp -d -t bufflehead-mas)"
CLEANUP_DIRS+=("$WORK")
security cms -D -i "$MAS_PROFILE" > "$WORK/profile.plist"
pb() { /usr/libexec/PlistBuddy -c "Print :$1" "$WORK/profile.plist"; }
TEAM_ID="$(pb 'TeamIdentifier:0')"
APP_IDENTIFIER="$(pb 'Entitlements:com.apple.application-identifier')"
BUNDLE_ID="$MAS_BUNDLE_ID"
echo "==> Profile: $(pb Name) (team $TEAM_ID, $APP_IDENTIFIER)"
# A profile for another bundle ID, or a Developer ID / development profile,
# signs fine but is rejected at upload — fail now instead of after the build.
[ "$APP_IDENTIFIER" = "$TEAM_ID.$BUNDLE_ID" ] \
    || { echo "Error: profile is for '$APP_IDENTIFIER', expected '$TEAM_ID.$BUNDLE_ID'" >&2; exit 1; }
if /usr/libexec/PlistBuddy -c 'Print :ProvisionedDevices' "$WORK/profile.plist" >/dev/null 2>&1; then
    echo "Error: profile lists devices — that is a development profile, not 'Mac App Store Connect'" >&2
    exit 1
fi

# The signed entitlements are the narrow sandbox set plus the identifiers the
# profile grants; App Store validation rejects a bundle missing either.
ENTITLEMENTS="$WORK/entitlements.plist"
cp "$BASE_ENTITLEMENTS" "$ENTITLEMENTS"
plist_set "$ENTITLEMENTS" com.apple.application-identifier string "$APP_IDENTIFIER"
plist_set "$ENTITLEMENTS" com.apple.developer.team-identifier string "$TEAM_ID"

# --- 0c. Upload credentials --------------------------------------------------
ALTOOL_AUTH=()
if [ "$UPLOAD" = "1" ]; then
    require APPLE_API_KEY_P8_BASE64 "UPLOAD=1 needs APPLE_API_KEY_P8_BASE64"
    require APPLE_API_KEY_ID "UPLOAD=1 needs APPLE_API_KEY_ID"
    require APPLE_API_ISSUER_ID "UPLOAD=1 needs APPLE_API_ISSUER_ID"
    # altool only reads the key from a private_keys dir, by its conventional name.
    export API_PRIVATE_KEYS_DIR="$WORK/private_keys"
    mkdir -p "$API_PRIVATE_KEYS_DIR"
    b64decode APPLE_API_KEY_P8_BASE64 "$API_PRIVATE_KEYS_DIR/AuthKey_${APPLE_API_KEY_ID}.p8"
    ALTOOL_AUTH=(--apiKey "$APPLE_API_KEY_ID" --apiIssuer "$APPLE_API_ISSUER_ID")
fi

cd "$ROOT"

# --- 1. Build ---------------------------------------------------------------
if [ "$SKIP_BUILD" = "1" ] || [ "$SKIP_PREPARE" = "1" ]; then
    echo "==> Skipping build"
else
    GD_VERSION="$(awk '$1=="graphics.gd"{print $2; exit}' go.mod)"
    echo "==> Installing gd CLI $GD_VERSION..."
    go install "graphics.gd/cmd/gd@$GD_VERSION"
    export PATH="$(go env GOPATH)/bin:$PATH"
    export GDPATH="${GDPATH:-$HOME/gd}"
    export GOTOOLCHAIN="$(go env GOVERSION)"

    echo "==> Building macOS app..."
    # Godot's headless export can segfault on teardown AFTER writing the .app.
    gd_rc=0
    GOOS=macos gd build || gd_rc=$?
    [ -d "$APP" ] || { echo "Error: gd build failed (exit $gd_rc): $APP not produced" >&2; exit 1; }
fi
[ -d "$APP" ] || { echo "Error: $APP not found" >&2; exit 1; }

# --- 2. Swap in the store-channel library (mas tag + locked DuckDB) ---------
if [ "$SKIP_PREPARE" = "1" ]; then
    echo "==> Skipping MAS preparation (SKIP_PREPARE=1)"
else
    require DUCKDB_AMD64 "Set DUCKDB_AMD64 to a bin/build-duckdb-mas --arch x86_64 output dir"
    require DUCKDB_ARM64 "Set DUCKDB_ARM64 to a bin/build-duckdb-mas --arch arm64 output dir"
    "$ROOT/bin/prepare-mas-bundle" --app "$APP" --arch universal \
        --duckdb-amd64 "$DUCKDB_AMD64" --duckdb-arm64 "$DUCKDB_ARM64" \
        --library-path "$LIBRARY_PATH"
fi

# The store build ships to both architectures, and so must every slice.
for bin in "$APP/Contents/MacOS/Bufflehead" "$APP/$LIBRARY_PATH"; do
    archs="$(lipo -archs "$bin")"
    case "$archs" in
        *x86_64*arm64*|*arm64*x86_64*) echo "    $(basename "$bin"): $archs" ;;
        *) echo "Error: $bin is not universal (got '$archs')" >&2; exit 1 ;;
    esac
done
# Refuse the Developer ID library: only the prepared engine carries provenance.
[ -f "$APP/Contents/Resources/duckdb-provenance.json" ] \
    || { echo "Error: no duckdb-provenance.json — run bin/prepare-mas-bundle first" >&2; exit 1; }

# --- 3. Info.plist ----------------------------------------------------------
INFO="$APP/Contents/Info.plist"
SHORT_VERSION="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$INFO")"
BUILD_NUMBER="${BUILD_NUMBER:-$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$INFO")}"
echo "==> Version $SHORT_VERSION (build $BUILD_NUMBER)"
plist_set "$INFO" CFBundleIdentifier string "$BUNDLE_ID"
plist_set "$INFO" CFBundleVersion string "$BUILD_NUMBER"
# The locked engine is built for 11.0, and the store requires 11.0 for arm64
# anyway; Godot's preset still says 10.12 for x86_64.
plist_set "$INFO" LSMinimumSystemVersion string 11.0
/usr/libexec/PlistBuddy -c 'Delete :LSMinimumSystemVersionByArchitecture' "$INFO" >/dev/null 2>&1 || true
# Only standard TLS/SSH encryption, which is exempt — answers App Store
# Connect's export-compliance question for every build up front.
plist_set "$INFO" ITSAppUsesNonExemptEncryption bool false
# App Store validation rejects anything but an exact category UTI. Godot builds
# this key from the preset by prefixing "public.app-category.", so pin it here.
plist_set "$INFO" LSApplicationCategoryType string public.app-category.developer-tools

# --- 4. Sign ----------------------------------------------------------------
cp "$MAS_PROFILE" "$APP/Contents/embedded.provisionprofile"
# Stray extended attributes (quarantine, Finder info) make codesign refuse
# with "resource fork, Finder information, or similar detritus not allowed".
xattr -cr "$APP"

# The .pkg installs as root, so a file without world-read becomes root-only and
# App Store validation rejects the package. Runs after every copy into the
# bundle: the profile above arrives 0600 from the CI's decoded secret.
unreadable="$(find "$APP" ! -perm -o=r -print)"
if [ -n "$unreadable" ]; then
    echo "==> Making bundle files world-readable:"
    sed "s|^$APP/|    |" <<<"$unreadable"
fi
chmod -R u+rwX,go+rX,go-w "$APP"

echo "==> Signing nested Mach-O binaries..."
# Libraries take no entitlements; only the app's main executable carries the
# sandbox. Deepest-first, as an outer signature is invalidated by re-signing
# anything inside it.
while IFS=$'\t' read -r -d '' _depth f; do
    echo "    sign: ${f#"$APP"/}"
    codesign --force --timestamp --options runtime --sign "$MAS_APP_IDENTITY" "$f"
done < <(
    find "$APP/Contents" -type f ! -path "$APP/Contents/MacOS/*" -print0 \
        | while IFS= read -r -d '' f; do
            if file -b "$f" | grep -q "Mach-O"; then
                printf '%s\t%s\0' "$(tr -cd '/' <<<"$f" | wc -c | tr -d ' ')" "$f"
            fi
        done | sort -z -t$'\t' -k1,1nr
)
while IFS= read -r -d '' fw; do
    codesign --force --timestamp --options runtime --sign "$MAS_APP_IDENTITY" "$fw"
done < <(find "$APP/Contents" -type d \( -name "*.framework" -o -name "*.bundle" \) -print0)

echo "==> Signing app bundle with sandbox entitlements..."
codesign --force --timestamp --options runtime \
    --entitlements "$ENTITLEMENTS" --sign "$MAS_APP_IDENTITY" "$APP"

echo "==> Verifying signature..."
codesign --verify --deep --strict --verbose=2 "$APP"
codesign --display --entitlements - --xml "$APP" > "$WORK/signed.plist"
for key in com.apple.security.app-sandbox com.apple.application-identifier com.apple.developer.team-identifier; do
    /usr/libexec/PlistBuddy -c "Print :$key" "$WORK/signed.plist" >/dev/null \
        || { echo "Error: signed app is missing entitlement $key" >&2; exit 1; }
done
# The Developer ID build's escape hatch must never reach the store build.
if /usr/libexec/PlistBuddy -c 'Print :com.apple.security.cs.disable-library-validation' "$WORK/signed.plist" >/dev/null 2>&1; then
    echo "Error: store build must not carry disable-library-validation" >&2
    exit 1
fi

# --- 5. Package -------------------------------------------------------------
echo "==> Building installer package..."
rm -f "$PKG"
productbuild --component "$APP" /Applications --sign "$MAS_INSTALLER_IDENTITY" "$PKG"
pkgutil --check-signature "$PKG"

# --- 6. Validate + upload ---------------------------------------------------
if [ "$UPLOAD" = "1" ]; then
    echo "==> Validating with App Store Connect..."
    xcrun altool --validate-app -f "$PKG" -t macos "${ALTOOL_AUTH[@]}"
    echo "==> Uploading to App Store Connect..."
    xcrun altool --upload-app -f "$PKG" -t macos "${ALTOOL_AUTH[@]}"
    echo "    Uploaded. Processing takes ~10-30 minutes; the build then appears"
    echo "    under the app's TestFlight / App Store tab in App Store Connect."
else
    echo "==> Skipping upload (set UPLOAD=1, or drop the .pkg into Transporter.app)."
fi

echo
echo "Done: $PKG"
ls -lh "$PKG"
