#!/bin/bash
# One-time Mac App Store credential setup, without Keychain Assistant.
# See docs/mac-app-store.md for the portal clicks between the two steps.
#
#   ./bin/mas-credentials csr
#       Make a private key + certificate signing request in ~/.bufflehead-mas.
#       Upload the .csr to the portal twice: "Apple Distribution" and
#       "Mac Installer Distribution".
#
#   ./bin/mas-credentials secrets APPLE_DIST.cer INSTALLER.cer PROFILE.provisionprofile
#       Check the downloaded certs match the key and the profile matches the
#       cert + bundle ID, pack both identities into one .p12, and store
#       MAS_CERT_P12_BASE64 / MAS_CERT_PASSWORD / MAS_PROFILE_BASE64 as GitHub
#       repo secrets (gh). Also imports the identities into your login keychain
#       so bin/sign-mas works locally.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIR="$HOME/.bufflehead-mas"
KEY="$DIR/mas.key"
CSR="$DIR/mas.csr"
BUNDLE_ID="${MAS_BUNDLE_ID:-app.bufflehead.bufflehead}"

die() { echo "Error: $*" >&2; exit 1; }

case "${1:-}" in
csr)
    mkdir -p "$DIR"
    chmod 700 "$DIR"
    [ -f "$KEY" ] && die "$KEY already exists — reuse its CSR ($CSR) or move it aside"
    read -r -p "Email for the certificate: " email
    (umask 077; openssl genrsa -out "$KEY" 2048 2>/dev/null)
    openssl req -new -key "$KEY" -out "$CSR" \
        -subj "/emailAddress=$email/CN=Bufflehead Mac App Store/C=US"
    echo "Wrote $CSR"
    echo "Upload it at https://developer.apple.com/account/resources/certificates/add"
    echo "twice: 'Apple Distribution' and 'Mac Installer Distribution'. Then run:"
    echo "  ./bin/mas-credentials secrets ~/Downloads/distribution.cer ~/Downloads/mac_installer_distribution.cer ~/Downloads/<profile>.provisionprofile"
    ;;
secrets)
    [ $# -eq 4 ] || die "usage: $0 secrets APPLE_DIST.cer INSTALLER.cer PROFILE.provisionprofile"
    app_cer="$2" inst_cer="$3" profile="$4"
    [ -f "$KEY" ] || die "no key at $KEY — run '$0 csr' first (certs only work with the key their CSR came from)"
    command -v gh >/dev/null || die "the GitHub CLI 'gh' is required (gh auth login)"
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT

    keymod="$(openssl rsa -in "$KEY" -noout -modulus)"
    for c in "$app_cer" "$inst_cer"; do
        [ -f "$c" ] || die "not found: $c"
        pem="$work/$(basename "$c").pem"
        openssl x509 -inform DER -in "$c" -out "$pem" 2>/dev/null \
            || openssl x509 -in "$c" -out "$pem"
        [ "$(openssl x509 -in "$pem" -noout -modulus)" = "$keymod" ] \
            || die "$c was not issued for $KEY (made from a different CSR?)"
        echo "  ok: $(openssl x509 -in "$pem" -noout -subject | sed 's/.*CN *= *//; s/,.*//')"
    done
    app_pem="$work/$(basename "$app_cer").pem"
    inst_pem="$work/$(basename "$inst_cer").pem"
    openssl x509 -in "$app_pem" -noout -subject | grep -q "Apple Distribution\|3rd Party Mac Developer Application" \
        || die "$app_cer is not an Apple Distribution cert (swapped arguments?)"
    openssl x509 -in "$inst_pem" -noout -subject | grep -q "Installer" \
        || die "$inst_cer is not a Mac Installer Distribution cert"

    security cms -D -i "$profile" > "$work/profile.plist"
    pb() { /usr/libexec/PlistBuddy -c "Print :$1" "$work/profile.plist"; }
    team="$(pb 'TeamIdentifier:0')"
    appid="$(pb 'Entitlements:com.apple.application-identifier')"
    [ "$appid" = "$team.$BUNDLE_ID" ] || die "profile is for '$appid', expected '$team.$BUNDLE_ID'"
    pb ProvisionedDevices >/dev/null 2>&1 \
        && die "profile lists devices — create a 'Mac App Store Connect' profile instead"
    # The profile must name the exact cert we just made, or signing "succeeds"
    # and the upload is rejected.
    pb 'DeveloperCertificates:0' > /dev/null
    want="$(openssl x509 -in "$app_pem" -outform DER | shasum | cut -d' ' -f1)"
    found=0 i=0
    while plutil -extract "DeveloperCertificates.$i" raw -o - "$work/profile.plist" > "$work/pc.b64" 2>/dev/null; do
        [ "$(base64 -D -i "$work/pc.b64" | shasum | cut -d' ' -f1)" = "$want" ] && found=1
        i=$((i + 1))
    done
    [ "$found" = 1 ] || die "profile doesn't include this Apple Distribution cert — edit the profile, tick it, re-download"
    echo "  ok: profile '$(pb Name)' for $appid"

    pw="$(openssl rand -base64 24)"
    # 3DES/SHA1 so macOS `security import` accepts it whatever openssl built it.
    openssl pkcs12 -export -inkey "$KEY" -in "$app_pem" -certfile "$inst_pem" \
        -name "Bufflehead MAS" -passout "pass:$pw" -out "$work/mas.p12" \
        -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES -macalg sha1

    cd "$ROOT"
    base64 -i "$work/mas.p12" | gh secret set MAS_CERT_P12_BASE64
    printf '%s' "$pw" | gh secret set MAS_CERT_PASSWORD
    base64 -i "$profile" | gh secret set MAS_PROFILE_BASE64
    echo "  ok: GitHub secrets MAS_CERT_P12_BASE64, MAS_CERT_PASSWORD, MAS_PROFILE_BASE64"

    security import "$work/mas.p12" -k "$HOME/Library/Keychains/login.keychain-db" \
        -P "$pw" -T /usr/bin/codesign -T /usr/bin/productbuild >/dev/null \
        && echo "  ok: imported into login keychain" \
        || echo "  note: login keychain import skipped/failed (only needed for local builds)"
    mkdir -p "$DIR" && cp "$profile" "$DIR/Bufflehead_Mac_App_Store.provisionprofile"
    echo
    echo "Done. Dry run:  gh workflow run build-mas.yml -f upload=false"
    echo "Keep $KEY safe (or delete it once the .p12 secret works); it is the private key."
    ;;
*)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
