#!/usr/bin/env python3
"""Prepare an already-exported Godot .app using clean locked DuckDB archive(s).
Does not sign, provision, upload or submit. Never accepts the incremental spike archive.

Thin:      --arch amd64 --duckdb BUILD
Universal: --arch universal --duckdb-amd64 BUILD_X86 --duckdb-arm64 BUILD_ARM
(universal builds each slice against its own engine, then lipo-merges them).
"""
import argparse,hashlib,json,os,pathlib,shutil,subprocess,tempfile
p=argparse.ArgumentParser();p.add_argument('--app',required=True);p.add_argument('--duckdb');p.add_argument('--duckdb-amd64');p.add_argument('--duckdb-arm64');p.add_argument('--library-path',required=True,help='Existing Go library path relative to the app bundle');p.add_argument('--arch',required=True,choices=['amd64','arm64','universal']);a=p.parse_args()
root=pathlib.Path(__file__).resolve().parent.parent;app=pathlib.Path(a.app).resolve();lib=(app/a.library_path).resolve()
if not lib.is_relative_to(app) or not lib.is_file() or not (app/'Contents/Info.plist').is_file():raise SystemExit('Expected exported app and existing library within it')
if a.arch=='universal':
 if not (a.duckdb_amd64 and a.duckdb_arm64):raise SystemExit('--arch universal needs --duckdb-amd64 and --duckdb-arm64')
 engines={'amd64':a.duckdb_amd64,'arm64':a.duckdb_arm64}
else:
 if not a.duckdb:raise SystemExit('--duckdb is required for a thin build')
 engines={a.arch:a.duckdb}
def verified(arch,path):
 engine=pathlib.Path(path).resolve()
 if not (engine/'provenance.json').is_file():raise SystemExit('Clean engine provenance is required; incremental spike libraries are rejected')
 m=json.loads((engine/'provenance.json').read_text())
 if not m.get('clean_source_build') or not m.get('disable_extension_load') or m.get('architecture')!= {'amd64':'x86_64','arm64':'arm64'}[arch]:raise SystemExit('Missing matching clean locked-engine provenance for '+arch)
 if hashlib.sha256((engine/'libduckdb.a').read_bytes()).hexdigest()!=m['sha256']:raise SystemExit('Engine checksum mismatch for '+arch)
 return engine,m
engines={arch:verified(arch,path) for arch,path in engines.items()}
# A staging path keeps failed compilation from overwriting the exported library.
with tempfile.TemporaryDirectory(prefix='bufflehead-mas-') as tmp:
 slices=[]
 for arch,(engine,_) in engines.items():
  env=os.environ.copy();env.update(GOOS='darwin',GOARCH=arch,CGO_ENABLED='1',MACOSX_DEPLOYMENT_TARGET='11.0')
  target=pathlib.Path(tmp)/(arch+'-'+lib.name)
  subprocess.run(['go','build','-p','2','-tags','mas,duckdb_use_static_lib','-ldflags','-extldflags "-L'+str(engine)+' -lduckdb -lc++ -lm"','-buildmode=c-shared','-o',str(target),'.'],cwd=root,env=env,check=True)
  slices.append(target)
 if len(slices)>1:
  merged=pathlib.Path(tmp)/lib.name
  subprocess.run(['lipo','-create','-output',str(merged),*map(str,slices)],check=True)
 else:merged=slices[0]
 shutil.copy2(merged,lib)
subprocess.run([str(root/'bin/bundle-licenses'),str(app)],check=True)
prov=engines[a.arch][1] if a.arch!='universal' else {arch:m for arch,(_,m) in engines.items()}
(app/'Contents/Resources/duckdb-provenance.json').write_text(json.dumps(prov,indent=2)+'\n')
print('Prepared unsigned MAS-channel bundle ('+a.arch+'). Apply provisioning/store signing and validate entitlements before submission.')
