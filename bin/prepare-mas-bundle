#!/usr/bin/env python3
"""Prepare an already-exported Godot .app using a clean locked DuckDB archive.
Does not sign, provision, upload or submit. Never accepts the incremental spike archive.
"""
import argparse,hashlib,json,pathlib,shutil,subprocess,tempfile
p=argparse.ArgumentParser();p.add_argument('--app',required=True);p.add_argument('--duckdb',required=True);p.add_argument('--library-path',required=True,help='Existing Go library path relative to the app bundle');p.add_argument('--arch',required=True,choices=['amd64','arm64']);a=p.parse_args()
root=pathlib.Path(__file__).resolve().parent.parent;app=pathlib.Path(a.app).resolve();engine=pathlib.Path(a.duckdb).resolve();lib=(app/a.library_path).resolve()
if not lib.is_relative_to(app) or not lib.is_file() or not (app/'Contents/Info.plist').is_file():raise SystemExit('Expected exported app and existing library within it')
if not (engine/'provenance.json').is_file():raise SystemExit('Clean engine provenance is required; incremental spike libraries are rejected')
m=json.loads((engine/'provenance.json').read_text())
if not m.get('clean_source_build') or not m.get('disable_extension_load') or m.get('architecture')!= {'amd64':'x86_64','arm64':'arm64'}[a.arch]:raise SystemExit('Missing matching clean locked-engine provenance')
if hashlib.sha256((engine/'libduckdb.a').read_bytes()).hexdigest()!=m['sha256']:raise SystemExit('Engine checksum mismatch')
import os
env=os.environ.copy();env.update(GOOS='darwin',GOARCH=a.arch,CGO_ENABLED='1')
# A staging path keeps failed compilation from overwriting the exported library.
with tempfile.TemporaryDirectory(prefix='bufflehead-mas-') as tmp:
 target=pathlib.Path(tmp)/lib.name
 subprocess.run(['go','build','-p','2','-tags','mas,duckdb_use_static_lib','-ldflags','-extldflags "-L'+str(engine)+' -lduckdb -lc++ -lm"','-buildmode=c-shared','-o',str(target),'.'],cwd=root,env=env,check=True)
 shutil.copy2(target,lib)
subprocess.run([str(root/'bin/bundle-licenses'),str(app)],check=True)
(app/'Contents/Resources/duckdb-provenance.json').write_text(json.dumps(m,indent=2)+'\n')
print('Prepared unsigned MAS-channel bundle. Apply provisioning/store signing and validate entitlements before submission.')
